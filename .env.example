# Скопируйте в .env и заполните. .env в git не коммитится.
# Комментарии — только отдельными строками: Docker не отрезает их после значения.

# Доступ к разрешённым моделям (общий ключ кейса). Без них работает всё, кроме вызовов модели.
# OpenAI-совместимый адрес провайдера, например https://<провайдер>/v1
LLM_BASE_URL=
LLM_API_KEY=

# Идентификаторы моделей у провайдера, если отличаются от названий в кейсе
LLM_MODEL_GEMMA=
LLM_MODEL_GLM=
LLM_MODEL_QWEN=
LLM_MODEL_DEEPSEEK=
LLM_MODEL_QWEN_VL=
LLM_MODEL_KIMI=

# Тарифы, ₽ за 1 млн токенов, формат «вход,выход». Нужны для учёта расхода и дневного лимита
LLM_PRICE_GEMMA=0,0
LLM_PRICE_GLM=0,0
LLM_PRICE_QWEN=0,0
LLM_PRICE_DEEPSEEK=0,0
LLM_PRICE_QWEN_VL=0,0
LLM_PRICE_KIMI=0,0
# Дневной лимит расхода с запасом до лимита кейса 500 ₽
LLM_DAILY_BUDGET_RUB=450

# Запросов к модели в минуту с одного адреса
RATE_LIMIT_PER_MIN=6
# Собрать свежие новости при запуске (нужен интернет): 1 — да, 0 — нет
COLLECT_ON_START=1
# Зафиксировать «сегодня» для воспроизводимой демонстрации (по умолчанию — текущая дата)
APP_TODAY=

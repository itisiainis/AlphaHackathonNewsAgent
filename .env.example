# Скопируйте в .env и заполните. .env в git не коммитится.
# Комментарии — только отдельными строками: Docker не отрезает их после значения.

# Доступ к разрешённым моделям (общий ключ кейса). Без них работает всё, кроме вызовов модели.
# OpenAI-совместимый прокси организаторов (инструкция по ключам трека). Ключ команды — только здесь, не в git и не в браузере
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=

# Идентификаторы моделей у прокси — копировать точно
LLM_MODEL_GEMMA=google/gemma-4-26b-a4b-it
LLM_MODEL_GLM=z-ai/glm-5.3-flash
LLM_MODEL_QWEN=qwen/qwen3.6-35b-a3b
LLM_MODEL_DEEPSEEK=deepseek/deepseek-v4.1-flash
LLM_MODEL_QWEN_VL=qwen/qwen3-vl-30b-a3b-instruct
LLM_MODEL_KIMI=moonshotai/kimi-k2.6

# Расход берётся из ответа прокси (usage.cost). Тарифы ниже — запасной вариант для другого провайдера,
# ₽ за 1 млн токенов, формат «вход,выход»
LLM_PRICE_GEMMA=0,0
LLM_PRICE_GLM=0,0
LLM_PRICE_QWEN=0,0
LLM_PRICE_DEEPSEEK=0,0
LLM_PRICE_QWEN_VL=0,0
LLM_PRICE_KIMI=0,0
# Дневной лимит расхода этого сервиса. Ключ общий на всю команду (500 ₽/день), поэтому лимит сервиса — 50 ₽
LLM_DAILY_BUDGET_RUB=50

# Запросов к модели в минуту с одного адреса
RATE_LIMIT_PER_MIN=10
# Собирать свежие новости при запуске и затем каждые COLLECT_EVERY_MIN минут (нужен интернет): 1 — да, 0 — нет
COLLECT_ON_START=1
COLLECT_EVERY_MIN=60
# Размечать новости моделью Gemma при сборе (~0,003 ₽ за 20 новостей): 1 — да, 0 — только словари
COLLECT_TRIAGE=1
# Полный разбор ИИ для 3 главных событий компании готовится заранее, в фоне (без нажатия): сколько событий и сколько
# разборов в день максимум. Заранее тратится не больше 60% дневного лимита. 0 — только по кнопке «Углубить с ИИ-аналитиком»
PRECOMPUTE_TOP=3
PRECOMPUTE_DAILY=15
# Токен панели управления для сотрудников банка (/#admin). Пусто — панель выключена.
# Длинная случайная строка, например: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# Зафиксировать «сегодня» для воспроизводимой демонстрации (по умолчанию — текущая дата)
APP_TODAY=

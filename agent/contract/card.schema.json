{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "Карточка события",
  "description": "Контракт агент → бэк → фронт. Сформирован по frontend/mock_data.json и CONTRIBUTING.md. Поля не переименовывать без договорённости команды.",
  "type": "object",
  "required": [
    "id",
    "type",
    "impact",
    "topics",
    "is_new",
    "published",
    "title",
    "takeaway",
    "key_points",
    "why_short",
    "matched",
    "sources",
    "blocks",
    "trace",
    "chat"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "risk",
        "opportunity",
        "info"
      ]
    },
    "impact": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "is_new": {
      "type": "boolean"
    },
    "published": {
      "$ref": "#/$defs/date"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Событие одной строкой"
    },
    "takeaway": {
      "type": "object",
      "description": "Главный вывод под роль — короткий слой карточки",
      "required": [
        "cfo",
        "ceo",
        "treasurer"
      ],
      "additionalProperties": false,
      "properties": {
        "cfo": {
          "type": "string",
          "minLength": 1
        },
        "ceo": {
          "type": "string",
          "minLength": 1
        },
        "treasurer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "key_points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/stmt"
      }
    },
    "why_short": {
      "type": "string",
      "minLength": 1
    },
    "matched": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Признаки компании, на которые сработало событие"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "blocks": {
      "type": "object",
      "required": [
        "what",
        "why",
        "risks",
        "opportunities",
        "actions",
        "bank",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "what": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "why": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "bank": {
          "type": "object",
          "required": [
            "quote",
            "doc",
            "date",
            "stale"
          ],
          "additionalProperties": false,
          "properties": {
            "quote": {
              "type": "string"
            },
            "plain": {
              "type": "string",
              "description": "Необязательно: позиция банка простыми словами для руководителя — вывод ИИ, цитата остаётся дословной"
            },
            "doc": {
              "type": "string"
            },
            "date": {
              "$ref": "#/$defs/date"
            },
            "stale": {
              "type": "boolean"
            }
          }
        },
        "calc": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/calc"
          },
          "description": "Расчёт эффекта кодом по формуле (agent/impact.py). Необязательный блок: нет числового шока в новости — нет расчёта"
        },
        "basis": {
          "type": "object",
          "required": [
            "features",
            "coverage"
          ],
          "additionalProperties": false,
          "properties": {
            "features": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "coverage": {
              "type": "string"
            }
          }
        }
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace_step"
      }
    },
    "chat": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chat_item"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "topic": {
      "enum": [
        "ставка",
        "долг",
        "курс",
        "ликвидность",
        "отрасль",
        "спрос",
        "контрагенты"
      ]
    },
    "stmt": {
      "type": "object",
      "description": "Утверждение. p — происхождение: fact (факт из источника) | bank (позиция банка) | ai (вывод ИИ)",
      "required": [
        "t",
        "p"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "string",
          "minLength": 1
        },
        "p": {
          "enum": [
            "fact",
            "bank",
            "ai"
          ]
        },
        "src": {
          "type": "integer",
          "minimum": 0
        },
        "strength": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "cta": {
          "type": "object",
          "required": [
            "label",
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "manager",
                "product"
              ]
            }
          }
        }
      }
    },
    "calc": {
      "type": "object",
      "description": "Расчёт: результат, формула, входные данные с происхождением, допущения. scale — пересчёт под сумму пользователя",
      "required": [
        "title",
        "value",
        "formula",
        "inputs",
        "assumptions",
        "sign"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sign": {
          "enum": [
            "risk",
            "opportunity",
            "neutral"
          ]
        },
        "strength": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "scale": {
          "type": "object",
          "required": [
            "label",
            "per_bn",
            "period"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "per_bn": {
              "type": "number"
            },
            "period": {
              "type": "string"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "date",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "news",
            "bank",
            "stat"
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "trace_step": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "detail",
        "ms",
        "cost"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "plan",
            "tool",
            "draft",
            "check",
            "research",
            "done"
          ]
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "ms": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "Стоимость шага в рублях"
        },
        "model": {
          "type": "string",
          "description": "Какая модель выполнила шаг (из списка кейса)"
        },
        "cached": {
          "type": "boolean",
          "description": "Ответ взят из кеша: время — время исходного вызова не отражает"
        }
      }
    },
    "chat_item": {
      "type": "object",
      "required": [
        "q",
        "a"
      ],
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string"
        },
        "a": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "chart": {
          "type": "object",
          "required": [
            "title",
            "points"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
